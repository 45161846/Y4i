<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <permission android:name="READ_EXTERNAL_STORAGE"/>

    <uses-permission android:name="android.permission.VIBRATE" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/icon_no_back_dark"
        android:label="@string/app_name"
        android:roundIcon="@drawable/icon_no_back_dark"
        android:supportsRtl="true"
        android:theme="@style/Theme.Russian"
        tools:targetApi="31">
        <meta-data android:name="android.max_aspect" android:value="2.4"/>
        <activity
            android:name=".NarechiaActivity"
            android:exported="true"
            android:theme="@style/Theme.Russian"/>
        <activity android:name=".gameClasses.GameActivity"
            android:exported="true"
            android:theme="@style/Theme.Russian"/>
        <activity
            android:name=".MainScreenActivity"
            android:exported="true"
            android:theme="@style/Theme.Russian">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>


        </activity>

    </application>


</manifest>